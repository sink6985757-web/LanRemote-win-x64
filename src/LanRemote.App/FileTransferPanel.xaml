<UserControl x:Class="LanRemote.App.FileTransferPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220" Foreground="#E5EDF8">
    <UserControl.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#155E75" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8FAFC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#164E63" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8FAFC" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#111C30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#30445F" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E5EDF8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#155E75" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#E5EDF8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#155E75" />
                    <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="檔案傳輸" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="左側選本機來源，右側選擇對方路徑；關閉面板不會取消進行中的傳輸。"
                           Foreground="#9FB0C8" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="12,6" CornerRadius="14" Background="#17384B"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="PermissionText" Text="等待已授權的工作階段" Foreground="#4FD1C5" />
                </Border>
                <Button Content="返回桌面" Background="#475569" Margin="0"
                        Click="ClosePanelButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,17,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="本機來源" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Content="選擇檔案…" Click="ChooseFilesButton_Click" />
                        <Button Content="選擇資料夾…" Click="ChooseFolderButton_Click" />
                        <Button Content="清除" Background="#475569" Click="ClearSourcesButton_Click" />
                    </StackPanel>
                    <ListBox Grid.Row="2" x:Name="LocalSourcesList" Background="#0B1425"
                             Foreground="#E5EDF8" BorderBrush="#30445F" />
                    <TextBlock Grid.Row="3" Text="下載到本機" Margin="0,13,0,5" Foreground="#AFC0D6" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalDestinationTextBox" />
                        <Button Grid.Column="1" Content="選擇…" Margin="8,0,0,0"
                                Click="ChooseLocalDestinationButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="對方路徑" FontSize="17" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="磁碟" Click="RemoteRootButton_Click" />
                        <Button Grid.Column="1" Content="上一層" Click="RemoteUpButton_Click" />
                        <TextBox Grid.Column="2" x:Name="RemotePathTextBox" Margin="0,0,8,0"
                                 KeyDown="RemotePathTextBox_KeyDown" />
                        <Button Grid.Column="3" Content="前往" Margin="0" Click="RemoteGoButton_Click" />
                    </Grid>
                    <ListView Grid.Row="2" x:Name="RemoteEntriesList" Background="#0B1425"
                              Foreground="#E5EDF8" BorderBrush="#30445F" SelectionMode="Extended"
                              MouseDoubleClick="RemoteEntriesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名稱" Width="255" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="類型" Width="75" DisplayMemberBinding="{Binding DisplayType}" />
                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding DisplaySize}" />
                                <GridViewColumn Header="修改時間" Width="145" DisplayMemberBinding="{Binding ModifiedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="傳送到目前對方路徑" Click="UploadButton_Click" />
                        <Button Content="接收選取項目" Background="#0F766E" Click="DownloadButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="7" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="傳送佇列" FontWeight="SemiBold" />
                    <ProgressBar Grid.Row="1" x:Name="UploadProgressBar" Height="8" Margin="0,7,0,5" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UploadStatusText" Text="就緒" Foreground="#AFC0D6"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" x:Name="CancelUploadButton" Content="取消"
                                Background="#991B1B" IsEnabled="False" Margin="8,0,0,0"
                                Click="CancelUploadButton_Click" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="7" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="接收佇列" FontWeight="SemiBold" />
                    <ProgressBar Grid.Row="1" x:Name="DownloadProgressBar" Height="8" Margin="0,7,0,5" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadStatusText" Text="就緒" Foreground="#AFC0D6"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" x:Name="CancelDownloadButton" Content="取消"
                                Background="#991B1B" IsEnabled="False" Margin="8,0,0,0"
                                Click="CancelDownloadButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
