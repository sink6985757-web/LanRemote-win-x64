<Window x:Class="LanRemote.App.PairingApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="允許本次遠端控制？" Width="520" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B1220" Foreground="#E5EDF8" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="遠端控制連線要求" FontSize="23" FontWeight="Bold" />
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="15" Background="#111C30"
                BorderBrush="#263750" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock x:Name="DeviceText" FontWeight="SemiBold" />
                <TextBlock x:Name="AddressText" Margin="0,6,0,0" Foreground="#AFC0D6" />
                <TextBlock x:Name="OperatingSystemText" Margin="0,4,0,0" Foreground="#AFC0D6"
                           TextWrapping="Wrap" />
                <TextBlock Text="配對碼" Margin="0,14,0,0" Foreground="#AFC0D6" />
                <TextBlock x:Name="PairingCodeText" FontFamily="Consolas" FontSize="29"
                           FontWeight="Bold" Foreground="#FCD34D" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14" Background="#142A36"
                BorderBrush="#28566A" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <CheckBox x:Name="AllowFileTransferCheckBox" FontWeight="SemiBold"
                          Content="允許本次連線傳輸檔案（預設關閉）" />
                <TextBlock Margin="24,7,0,0" Foreground="#9FC3D2" TextWrapping="Wrap"
                           Text="雙方同意後，兩臺電腦都可主動瀏覽對方可存取的資料夾並傳輸；斷線後授權自動失效。" />
                <CheckBox x:Name="AllowClipboardTextCheckBox" Margin="0,16,0,0"
                          FontWeight="SemiBold" IsChecked="True"
                          Content="允許本次連線同步文字剪貼簿（預設開啟）" />
                <TextBlock Margin="24,7,0,0" Foreground="#9FC3D2" TextWrapping="Wrap"
                           Text="只同步純文字，不同步圖片、格式或檔案；控制端可選擇單向、雙向或關閉。" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,16,0,0" Foreground="#FCA5A5" TextWrapping="Wrap"
                   Text="只有在兩臺畫面顯示相同六位數配對碼，且你認得這臺裝置時，才允許連線。" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="拒絕" Width="105" Margin="0,0,10,0" Padding="12,8"
                    IsCancel="True" Click="RejectButton_Click" />
            <Button Content="允許本次連線" Width="145" Padding="12,8"
                    Background="#1D4ED8" Foreground="White" FontWeight="SemiBold"
                    IsDefault="True" Click="AcceptButton_Click" />
        </StackPanel>
    </Grid>
</Window>
