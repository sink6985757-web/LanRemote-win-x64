<Window x:Class="LanRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRemote — 區網雙向控制 MVP"
        Width="1180" Height="820" MinWidth="900" MinHeight="680"
        Background="#0B1220" Foreground="#E5EDF8"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111C30" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263750" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FD1C5" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Background" Value="#0B1425" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LanRemote" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="同一套程式可當被控端或控制端；斷線後交換角色即可反向控制。"
                           Foreground="#9FB0C8" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#17384B" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadge" Text="尚未連線" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="A. 讓這臺電腦被控制" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="啟動後，把下方區網位址告訴另一臺電腦。每次連線都會顯示六位數配對碼並要求核准。"
                               Foreground="#9FB0C8" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <TextBlock Text="連接埠" Foreground="#BCC9DA" />
                    <TextBox x:Name="HostPortTextBox" Text="45873" MaxLength="5" />
                    <TextBlock Text="本機可用位址" Foreground="#BCC9DA" Margin="0,10,0,0" />
                    <TextBlock x:Name="LocalAddressesText" Text="讀取中…" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartHostButton" Content="開始等候" Click="StartHostButton_Click" />
                        <Button x:Name="StopHostButton" Content="停止被控端" Click="StopHostButton_Click"
                                Background="#7F1D1D" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="B. 控制另一臺電腦" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="在另一臺先按「開始等候」，再輸入它顯示的 IPv4:連接埠。請人工核對兩端配對碼。"
                               Foreground="#9FB0C8" TextWrapping="Wrap" Margin="0,5,0,10" />
                    <TextBlock Text="被控端位址" Foreground="#BCC9DA" />
                    <TextBox x:Name="RemoteEndpointTextBox" Text="192.168.1.2:45873" />
                    <TextBlock Text="本次配對碼" Foreground="#BCC9DA" Margin="0,10,0,0" />
                    <TextBlock x:Name="PairingCodeText" Text="—— —— ——" FontFamily="Consolas"
                               FontSize="25" FontWeight="Bold" Foreground="#FCD34D" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectButton" Content="連線並核對" Click="ConnectButton_Click" />
                        <Button x:Name="DisconnectButton" Content="立即斷線" Click="DisconnectButton_Click"
                                Background="#7F1D1D" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="請選擇這臺電腦本次要扮演的角色。" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="安全範圍：僅限私人區網、TLS 暫時憑證、每次明確核准；無法控制 UAC／安全桌面。"
                               Foreground="#91A4BF" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="MetricsText" Grid.Column="1" Text="尚無畫面資料" Foreground="#91A4BF"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#050A12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <Grid>
                <TextBlock x:Name="RemoteDisplayPlaceholder"
                           Text="控制端連線成功後，遠端主要螢幕會顯示在這裡。&#x0a;按一下畫面後即可傳送滑鼠與鍵盤；Esc 不會自動解除連線，請使用「立即斷線」。"
                           Foreground="#60728E" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" MaxWidth="580" />
                <Image x:Name="RemoteDisplay" Stretch="Uniform" Focusable="True" Visibility="Collapsed"
                       MouseMove="RemoteDisplay_MouseMove"
                       MouseDown="RemoteDisplay_MouseDown" MouseUp="RemoteDisplay_MouseUp"
                       MouseWheel="RemoteDisplay_MouseWheel"
                       PreviewKeyDown="RemoteDisplay_PreviewKeyDown" PreviewKeyUp="RemoteDisplay_PreviewKeyUp" />
            </Grid>
        </Border>
    </Grid>
</Window>
