<Window x:Class="LanRemote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRemote — 區網雙向控制"
        Width="1180" Height="820" MinWidth="900" MinHeight="640"
        Background="#0B1220" Foreground="#E5EDF8"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111C30" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263750" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FD1C5" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="0,7,8,0" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Background" Value="#0B1425" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#253650" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border x:Name="ChromePanel" DockPanel.Dock="Top" Background="#E8EDF3"
                    MouseLeave="ChromePanel_MouseLeave">
                <StackPanel>
                    <Menu x:Name="MainMenu" Background="#E8EDF3" Foreground="#182234">
                        <MenuItem Header="_File">
                            <MenuItem Header="結束(_X)" InputGestureText="Alt+F4" Click="ExitMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="_Connection">
                            <MenuItem x:Name="StartHostMenuItem" Header="開始等候(_H)" Click="StartHostButton_Click" />
                            <MenuItem x:Name="StopHostMenuItem" Header="停止被控端(_S)" Click="StopHostButton_Click" IsEnabled="False" />
                            <Separator />
                            <MenuItem x:Name="ConnectMenuItem" Header="連線(_C)" Click="ConnectButton_Click" />
                            <MenuItem x:Name="DisconnectMenuItem" Header="立即斷線(_D)" Click="DisconnectButton_Click" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem x:Name="WindowedMenuItem" Header="視窗化(_W)" IsCheckable="True"
                                      Click="WindowedMenuItem_Click" />
                            <MenuItem x:Name="MaximizedMenuItem" Header="最大化(_M)" IsCheckable="True"
                                      Click="MaximizedMenuItem_Click" />
                            <MenuItem x:Name="FullscreenMenuItem" Header="全螢幕(_F)" InputGestureText="F11"
                                      IsCheckable="True" Click="FullscreenMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="縮放模式(_S)">
                                <MenuItem x:Name="FitScaleMenuItem" Header="符合視窗（保留比例）"
                                          IsCheckable="True" Click="FitScaleMenuItem_Click" />
                                <MenuItem x:Name="StretchScaleMenuItem" Header="拉伸滿版"
                                          IsCheckable="True" IsChecked="True" Click="StretchScaleMenuItem_Click" />
                                <MenuItem x:Name="CropScaleMenuItem" Header="裁切滿版（保留比例）"
                                          IsCheckable="True" Click="CropScaleMenuItem_Click" />
                            </MenuItem>
                            <MenuItem x:Name="ShowChromeMenuItem" Header="顯示工具列(_T)" IsCheckable="True"
                                      IsChecked="True" Click="ShowChromeMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="_Quality">
                            <MenuItem x:Name="SmoothQualityMenuItem" Header="流暢 — 720p / 60 fps"
                                      IsCheckable="True" Click="SmoothQualityMenuItem_Click" />
                            <MenuItem x:Name="BalancedQualityMenuItem" Header="平衡 — 900p / 48 fps"
                                      IsCheckable="True" IsChecked="True" Click="BalancedQualityMenuItem_Click" />
                            <MenuItem x:Name="QualityQualityMenuItem" Header="畫質 — 1080p / 30 fps"
                                      IsCheckable="True" Click="QualityQualityMenuItem_Click" />
                        </MenuItem>
                    </Menu>

                    <ToolBarTray x:Name="SessionToolBarTray" Background="#D7DEE8">
                        <ToolBar Background="#D7DEE8" Foreground="#162033" Band="1" BandIndex="1">
                            <Button x:Name="WindowedToolButton" Style="{StaticResource ToolButtonStyle}"
                                    Content="▣ 視窗化" ToolTip="自適應視窗大小" Click="WindowedMenuItem_Click" />
                            <Button x:Name="MaximizedToolButton" Style="{StaticResource ToolButtonStyle}"
                                    Content="▤ 最大化" Click="MaximizedMenuItem_Click" />
                            <Button x:Name="FullscreenToolButton" Style="{StaticResource ToolButtonStyle}"
                                    Content="⛶ 全螢幕" ToolTip="F11" Click="FullscreenMenuItem_Click" />
                            <Separator />
                            <TextBlock Text="畫面：" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="QualityComboBox" Width="185" SelectedIndex="1"
                                      SelectionChanged="QualityComboBox_SelectionChanged">
                                <ComboBoxItem Content="流暢  720p / 60 fps" />
                                <ComboBoxItem Content="平衡  900p / 48 fps" />
                                <ComboBoxItem Content="畫質  1080p / 30 fps" />
                            </ComboBox>
                            <Separator />
                            <TextBlock Text="縮放：" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="ScaleModeComboBox" Width="120" SelectedIndex="1"
                                      SelectionChanged="ScaleModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="符合視窗" />
                                <ComboBoxItem Content="拉伸滿版" />
                                <ComboBoxItem Content="裁切滿版" />
                            </ComboBox>
                            <Separator />
                            <Button x:Name="SasToolButton" Style="{StaticResource ToolButtonStyle}"
                                    Content="Ctrl+Alt+Delete" Click="SasToolButton_Click" />
                            <Button x:Name="CtrlAltZeroToolButton" Style="{StaticResource ToolButtonStyle}"
                                    Content="Ctrl+Alt+0" Click="CtrlAltZeroToolButton_Click" />
                            <Menu Background="Transparent" Foreground="#162033" VerticalAlignment="Center">
                                <MenuItem x:Name="ShortcutToolMenu" Header="⌨ 自訂按鍵">
                                    <MenuItem x:Name="CustomShortcutEntriesMenu" Header="送出自訂按鍵" />
                                    <Separator />
                                    <MenuItem Header="新增自訂按鍵…" Click="AddCustomShortcutMenuItem_Click" />
                                    <MenuItem x:Name="RemoveCustomShortcutMenu" Header="移除自訂按鍵" />
                                </MenuItem>
                            </Menu>
                            <Separator />
                            <TextBlock x:Name="SessionInfoText" Text="尚未連線" Margin="8,0"
                                       Foreground="#46566D" VerticalAlignment="Center" />
                            <Separator />
                            <Button x:Name="ToolbarDisconnectButton" Style="{StaticResource ToolButtonStyle}"
                                    Background="#991B1B" Content="■ 立即斷線" Click="DisconnectButton_Click" />
                            <Button Style="{StaticResource ToolButtonStyle}" Content="隱藏工具列"
                                    Click="HideChromeButton_Click" />
                        </ToolBar>
                    </ToolBarTray>
                </StackPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom" Background="#111C30" Foreground="#C9D6E8" Padding="8,3">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="請選擇這臺電腦本次要扮演的角色。" />
                </StatusBarItem>
                <Separator />
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="MetricsText" Text="尚無畫面資料" Foreground="#91A4BF" />
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid x:Name="LauncherView" Background="#0B1220" Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LanRemote" FontSize="28" FontWeight="Bold" />
                            <TextBlock Text="兩臺電腦使用同一套程式；斷線交換角色後即可反向控制。"
                                       Foreground="#9FB0C8" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#17384B" CornerRadius="16" Padding="14,7"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ModeBadge" Text="尚未連線" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="A. 讓這臺電腦被控制" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="啟動後，把區網位址告訴另一臺。每次連線都會顯示六位數配對碼並要求核准。"
                                           Foreground="#9FB0C8" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <TextBlock Text="連接埠" Foreground="#BCC9DA" />
                                <TextBox x:Name="HostPortTextBox" Text="45873" MaxLength="5" />
                                <TextBlock Text="本機可用位址" Foreground="#BCC9DA" Margin="0,10,0,0" />
                                <TextBlock x:Name="LocalAddressesText" Text="讀取中…" Foreground="{StaticResource AccentBrush}"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartHostButton" Content="開始等候" Click="StartHostButton_Click" />
                                    <Button x:Name="StopHostButton" Content="停止被控端" Click="StopHostButton_Click"
                                            Background="#7F1D1D" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="B. 控制另一臺電腦" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="在另一臺先按『開始等候』，再輸入它的 IPv4:連接埠並核對配對碼。"
                                           Foreground="#9FB0C8" TextWrapping="Wrap" Margin="0,5,0,10" />
                                <TextBlock Text="被控端位址" Foreground="#BCC9DA" />
                                <TextBox x:Name="RemoteEndpointTextBox" Text="192.168.1.2:45873" />
                                <TextBlock Text="連線畫面模式" Foreground="#BCC9DA" Margin="0,10,0,0" />
                                <TextBlock x:Name="SelectedQualityText" Text="平衡 — 1600×900 / 48 fps"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                                <TextBlock Text="本次配對碼" Foreground="#BCC9DA" Margin="0,10,0,0" />
                                <TextBlock x:Name="PairingCodeText" Text="—— —— ——" FontFamily="Consolas"
                                           FontSize="25" FontWeight="Bold" Foreground="#FCD34D" Margin="0,3,0,0" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ConnectButton" Content="連線並核對" Click="ConnectButton_Click" />
                                    <Button x:Name="DisconnectButton" Content="立即斷線" Click="DisconnectButton_Click"
                                            Background="#7F1D1D" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="SessionView" Visibility="Collapsed" Background="#02050A">
                    <TextBlock x:Name="RemoteDisplayPlaceholder"
                               Text="正在等待第一張遠端畫面…"
                               Foreground="#60728E" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="17" />
                    <Image x:Name="RemoteDisplay" Stretch="Fill" Focusable="True" Visibility="Collapsed"
                           Cursor="None" MouseEnter="RemoteDisplay_MouseEnter" MouseLeave="RemoteDisplay_MouseLeave"
                           MouseMove="RemoteDisplay_MouseMove"
                           MouseDown="RemoteDisplay_MouseDown" MouseUp="RemoteDisplay_MouseUp"
                           MouseWheel="RemoteDisplay_MouseWheel"
                           PreviewKeyDown="RemoteDisplay_PreviewKeyDown"
                           PreviewKeyUp="RemoteDisplay_PreviewKeyUp" />
                    <Canvas x:Name="ControllerCursorLayer" IsHitTestVisible="False" Visibility="Collapsed">
                        <Ellipse x:Name="ControllerCursorHalo" Width="30" Height="30"
                                 Fill="#334FD1C5" Stroke="#884FD1C5" StrokeThickness="1" />
                        <Path x:Name="ControllerCursorArrow"
                              Data="M 0,0 L 0,22 L 5.5,16.5 L 10,25 L 14,23 L 9.5,14.5 L 18,14.5 Z"
                              Fill="#4FD1C5" Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Grid>
            </Grid>
        </DockPanel>

        <Border x:Name="TopRevealStrip" Height="7" VerticalAlignment="Top" Panel.ZIndex="100"
                Background="#4FD1C5" Opacity="0.55" Visibility="Collapsed"
                MouseEnter="TopRevealStrip_MouseEnter" ToolTip="顯示工具列" />
    </Grid>
</Window>
