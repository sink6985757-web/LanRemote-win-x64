<Window x:Class="LanRemote.App.FileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRemote 檔案傳輸" Width="1040" Height="690" MinWidth="900" MinHeight="570"
        WindowStartupLocation="CenterOwner" Background="#0B1220" Foreground="#E5EDF8"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#111C30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#30445F" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="檔案傳輸" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="左側選本機來源；右側像檔案總管一樣選擇遠端路徑。"
                           Foreground="#9FB0C8" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="14" Background="#17384B"
                    VerticalAlignment="Center">
                <TextBlock x:Name="PermissionText" Text="本次 session 已允許" Foreground="#4FD1C5" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,17,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="本機來源" FontSize="17" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Content="選擇檔案…" Click="ChooseFilesButton_Click" />
                        <Button Content="選擇資料夾…" Click="ChooseFolderButton_Click" />
                        <Button Content="清除" Background="#475569" Click="ClearSourcesButton_Click" />
                    </StackPanel>
                    <ListBox Grid.Row="2" x:Name="LocalSourcesList" Background="#0B1425"
                             Foreground="#E5EDF8" BorderBrush="#30445F" />
                    <TextBlock Grid.Row="3" Text="下載到本機" Margin="0,13,0,5" Foreground="#AFC0D6" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocalDestinationTextBox" />
                        <Button Grid.Column="1" Content="選擇…" Margin="8,0,0,0"
                                Click="ChooseLocalDestinationButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#111C30" BorderBrush="#263750" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="遠端路徑" FontSize="17" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="磁碟" Click="RemoteRootButton_Click" />
                        <Button Grid.Column="1" Content="上一層" Click="RemoteUpButton_Click" />
                        <TextBox Grid.Column="2" x:Name="RemotePathTextBox" Margin="0,0,8,0"
                                 KeyDown="RemotePathTextBox_KeyDown" />
                        <Button Grid.Column="3" Content="前往" Margin="0" Click="RemoteGoButton_Click" />
                    </Grid>
                    <ListView Grid.Row="2" x:Name="RemoteEntriesList" Background="#0B1425"
                              Foreground="#E5EDF8" BorderBrush="#30445F" SelectionMode="Extended"
                              MouseDoubleClick="RemoteEntriesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名稱" Width="255" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="類型" Width="75" DisplayMemberBinding="{Binding DisplayType}" />
                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding DisplaySize}" />
                                <GridViewColumn Header="修改時間" Width="145" DisplayMemberBinding="{Binding ModifiedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="上傳到目前遠端路徑" Click="UploadButton_Click" />
                        <Button Content="下載選取項目" Background="#0F766E" Click="DownloadButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="TransferProgressBar" Height="9" Minimum="0" Maximum="100" />
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TransferStatusText" Text="就緒" Foreground="#AFC0D6"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" x:Name="CancelTransferButton" Content="取消傳輸"
                        Background="#991B1B" IsEnabled="False" Click="CancelTransferButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
